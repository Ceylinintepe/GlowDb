@model GlowDb.Models.Urunler

@{
    ViewBag.Title = "Ürün Düzenle";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>GlowBox - Ürün Düzenle</title>

    <style>
        body {
            background: #f8f5fc;
           
        }

        .form-kutu {
            background: white;
            width: 450px;
            margin: 50px auto;
            padding: 30px;
            border-radius: 12px;
        }

        h2 {
            color: #51277e;
          
        }

        label {
            display: block;
            margin-top: 15px;
            color: #51277e;
        }

        input, textarea, select {
            width: 100%;
            padding: 11px;
            margin-top: 7px;
        
        }

        button {
            background: #6c3b96;
            color: white;
            border: none;
            padding: 13px;
            width: 100%;
            margin-top: 20px;
     
        }
    </style>
</head>

<body>

    <div class="form-kutu">

        <h2>Ürün Düzenle</h2>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(x => x.UrunID)

            <label>Ürün Adı</label>
            @Html.TextBoxFor(x => x.UrunAdi)

            <label>Marka</label>
            @Html.TextBoxFor(x => x.Marka)

            <label>Açıklama</label>
            @Html.TextAreaFor(x => x.Aciklama)

            <label>Kategori</label>
            @Html.DropDownListFor(
                x => x.KategoriID,
                (SelectList)ViewBag.KategoriID,
                "Kategori Seçiniz"
            )

            <button type="submit">Değişiklikleri Kaydet</button>
        }

        <a href="/Urun/Index">Geri Dön</a>

    </div>

</body>
</html>